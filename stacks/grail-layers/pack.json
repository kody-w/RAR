{
  "schema": "rapp-rar-stack/1.1",
  "name": "grail-layers",
  "display_name": "Grail layers",
  "version": "1.1.1",
  "purpose": "Updates for every Brainstem that install over the unchanged grail and can fail without breaking it. A supervisor applies each layer in memory at start, probes /chat, and falls back to plain grail on any failure. First layer: Responses-API models (gpt-6.1-sol, gpt-6-luna) work in the unchanged grail.",
  "install": {
    "type": "grail_layers",
    "one_liner": "curl -fsSL https://kody-w.github.io/grail-layers/install.sh | bash",
    "uninstall": "curl -fsSL https://kody-w.github.io/grail-layers/uninstall.sh | bash",
    "layers": [
      "responses_models.py"
    ],
    "default_enabled": [
      "responses_models"
    ],
    "supervisor": "https://kody-w.github.io/grail-layers/grail_layers.py",
