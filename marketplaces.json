        "copilot_install": "copilot plugin install rapp@brainstem",
        "claude_marketplace_add": "claude plugin marketplace add kody-w/rapp-installer",
        "claude_install": "claude plugin install rapp@brainstem"
      }
    },
    {
      "identity": "rapp@rar",
      "plugin": "rapp",
      "marketplace": "rar",
      "version": "1.3.0",
