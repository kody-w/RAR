      "purpose": "Operate RAR, reversible skills, Brainstem bootstrap, manual exports, and external-AI collaboration callbacks.",
      "clients": [
        "Microsoft Scout",
        "GitHub Copilot CLI",
        "Claude Code"
      ],
      "commands": {
        "copilot_marketplace_add": "copilot plugin marketplace add kody-w/RAR",
