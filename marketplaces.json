  "constitutional_article": "https://github.com/kody-w/RAR/blob/main/CONSTITUTION.md#article-xxiv--the-rappx-marketplace-identity",
  "marketplaces": [
    {
      "identity": "rapp@brainstem",
      "plugin": "rapp",
      "marketplace": "brainstem",
      "version": "1.0.0",
